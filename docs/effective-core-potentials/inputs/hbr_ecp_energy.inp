# BHHLYP/aug-cc-pVDZ-PP(Br), aug-cc-pVDZ(H) energy of HBr, using an ECP on Br.
# The "-PP" basis carries an effective core potential for bromine's core;
# the light H atom keeps an all-electron basis. OpenQP builds the ECP via libecpint.
[input]
system=
   35   0.000000000   0.000000000   0.000000000     # Br
   1    0.000000000   0.000000000   1.407611        # H
charge=0
runtype=energy
functional=bhhlyp
basis=aug-cc-pVDZ-PP;aug-cc-pVDZ
method=hf

[guess]
type=huckel
save_mol=false

[scf]
multiplicity=1
type=rhf

[dftgrid]
rad_type=becke
