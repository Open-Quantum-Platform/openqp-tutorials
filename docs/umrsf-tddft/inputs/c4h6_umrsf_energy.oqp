H   -2.755248674   -0.545115910    0.000000000
H   -2.071562576    1.183086840    0.000000000
H    2.755248674    0.545115910    0.000000000
H   -0.441348756   -1.477941036    0.000000000
H    2.071562576   -1.183086840    0.000000000
